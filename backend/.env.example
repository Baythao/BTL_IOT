# Copy thanh file .env (cung thu muc) roi dien gia tri. KHONG commit file .env.
DB_URL=jdbc:postgresql://<SESSION_POOLER_HOST>:5432/postgres?sslmode=require&currentSchema=firewatch
DB_USER=postgres.<PROJECT_REF>
DB_PASS=

MQTT_URL=tcp://127.0.0.1:1883
MQTT_USER=firewatch-server
MQTT_PASS=

# Chi dung de tao Admin dau tien (>= 10 ky tu). Tao xong nen xoa gia tri.
ADMIN_USER=admin
ADMIN_PASS=

WEB_PORT=8080
