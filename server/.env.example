MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_TLS=0
MQTT_USER=firewatch-server
MQTT_PASS=DIEN_MAT_KHAU
DEVICE_ID=esp32-tang1
# De trong de dung CA tin cay cua he dieu hanh. Neu broker dung CA rieng: duong dan PEM.
MQTT_CA_FILE=
# Chay thu truoc: chi ghi log, KHONG gui thong bao/SMS va KHONG tinh phi SMS.
DRY_RUN=1
PUSH_ENABLED=1
SMS_ENABLED=1
PUSHOVER_TOKEN=DIEN_APPLICATION_TOKEN
PUSHOVER_USER=DIEN_USER_KEY
TWILIO_ACCOUNT_SID=DIEN_ACCOUNT_SID
TWILIO_AUTH_TOKEN=DIEN_AUTH_TOKEN
# Sender do Twilio cho phep gui toi Viet Nam; khong tuy y dien so dien thoai ca nhan.
TWILIO_FROM=DIEN_SENDER_DA_DUOC_CHAP_NHAN
# Dinh dang +84..., bo so 0 dau (vi du 09... thanh +849...).
SMS_TO=DIEN_SO_NHAN
SITE_NAME=Mo hinh tang 1
# Web: setup_web.py tu tao WEB_SECRET; khong tu dien khoa de doan.
WEB_HOST=0.0.0.0
WEB_PORT=5000
# Chi dat 1 khi da trien khai HTTPS. LAN HTTP de 0.
WEB_HTTPS=0
